# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO — Vantix
# ------------------------------------------------------------
# Copia este archivo a ".env.local" para desarrollo local
# y pega tu API key real ahi (ese archivo NO se sube a GitHub).
# En produccion, estas variables se configuran en el panel de Vercel.
# ============================================================

# Proveedor de LLM activo: "gemini" | "anthropic" | "openai" | "demo"
# "demo" = respuestas pre-generadas, sin llamar a ningun LLM (costo cero absoluto)
LLM_PROVIDER=gemini

# API key de Google Gemini (sacar en https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_aqui

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-2.5-flash

# (Opcional) Si algun dia cambias de proveedor:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
